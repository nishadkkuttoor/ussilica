table fact_sales_tax_reconciliation
	lineageTag: 37fa0528-2e15-4a9c-a2bb-31c333dcc5fd

	measure 'Taxable Amount' = SUM(fact_sales_tax_reconciliation[taxable_amount])
		formatString: \$#,0;-\$#,0
		displayFolder: Tax
		lineageTag: 98337150-d3b0-45a6-b724-6b0c26f02bfb

	measure 'Non-Taxable Amount' = SUM(fact_sales_tax_reconciliation[non_taxable_amount])
		formatString: \$#,0;-\$#,0
		displayFolder: Tax
		lineageTag: b18852d9-b5c5-4829-9a31-25743a2ed204

	measure 'Tax Amount' = SUM(fact_sales_tax_reconciliation[tax_amount])
		formatString: \$#,0;-\$#,0
		displayFolder: Tax
		lineageTag: ab280b76-e99d-4f74-82d3-2e0083476963

	measure 'Gross Amount' = SUM(fact_sales_tax_reconciliation[gross_amount])
		formatString: \$#,0;-\$#,0
		displayFolder: Tax
		lineageTag: 5198b168-fafa-4514-91a3-610ad4b78159

	measure 'Effective Tax Rate' = DIVIDE([Tax Amount], [Taxable Amount])
		formatString: 0.0%
		displayFolder: Tax
		lineageTag: f6514ae8-6119-417c-986d-e4b0eb1f9f9e

	measure 'Invoice Count' = DISTINCTCOUNT(fact_sales_tax_reconciliation[avalara_code])
		formatString: #,0
		displayFolder: Counts
		lineageTag: 7ef4b0e5-8f9f-49c3-a2b2-ed2ce6ff4998

	measure 'Tax Lines' = COUNTROWS(fact_sales_tax_reconciliation)
		formatString: #,0
		displayFolder: Counts
		lineageTag: 6b979a6c-da11-4dee-a5b2-b12bc0a4388f

	/// Taxable / Non-Taxable flag. PHYSICAL column materialised by the fact notebook from the
	/// summed tax_amount — Direct Lake does not support DAX calculated columns.
