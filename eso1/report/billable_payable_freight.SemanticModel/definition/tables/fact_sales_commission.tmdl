table fact_sales_commission
	lineageTag: 0a518d6b-e8e1-5933-aca5-0bc33a8116b7

	measure 'Commission Sales Line Amount' = SUM('fact_sales_commission'[amount_sales_total_line])
		formatString: \$#,0;-\$#,0
		displayFolder: Commission
		lineageTag: 1deaf8da-f6e4-5097-a719-2024f43d9e07

	measure 'Commission Line Cost' = SUM('fact_sales_commission'[amount_sales_line_total_cost])
		formatString: \$#,0;-\$#,0
		displayFolder: Commission
		lineageTag: 54a396c2-5d42-593c-bb54-c75627ab55d9

	measure 'Commission Amount' = SUM('fact_sales_commission'[amount_commission])
		formatString: \$#,0;-\$#,0
		displayFolder: Commission
		lineageTag: 76e769bd-04d1-56c7-a1b6-7f654ee22f1e

	measure 'Commission Quantity Shipped' = CALCULATE(SUM('fact_sales_commission'[quantity_shipped]), 'fact_sales_commission'[is_primary_commission_line]="Y")
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: 41be4efa-8416-5c09-9aad-b538b6abdf1e

	measure 'Commission Extended Price' = CALCULATE(SUM('fact_sales_commission'[extended_price]), 'fact_sales_commission'[is_primary_commission_line]="Y")
		formatString: \$#,0;-\$#,0
		displayFolder: Volume
		lineageTag: 23783d4c-3add-5a1d-94bc-d2b0d1822fa0

	measure 'Commission Extended Cost' = CALCULATE(SUM('fact_sales_commission'[extended_cost]), 'fact_sales_commission'[is_primary_commission_line]="Y")
		formatString: \$#,0;-\$#,0
		displayFolder: Volume
		lineageTag: 1805f157-7f1f-540d-956d-ed5127fb116b

	measure 'Commission Primary Qty Ordered' = CALCULATE(SUM('fact_sales_commission'[primary_quantity_ordered]), 'fact_sales_commission'[is_primary_commission_line]="Y")
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: 89244d38-a16a-573e-8cb3-a22de8825918

	measure 'Salesperson Name' = SELECTEDVALUE(dim_address_salesperson[address_number]) & " - " & SELECTEDVALUE(dim_address_salesperson[name_alpha])
		displayFolder: Names
		lineageTag: 93b7e452-1312-57fe-9a98-6a466fc0bdc5

