table fact_price_adjustment
	lineageTag: c1a4401c-abc0-5b2d-962d-36bcf574f807

	measure 'Adj Quantity Shipped' = SUM('fact_price_adjustment'[quantity_shipped])
		formatString: #,0.00
		displayFolder: Adjustments
		lineageTag: 58e80b0e-7ac7-5da7-9f11-2a3a3d02f18a

	measure 'Adj Extended Price' = SUM('fact_price_adjustment'[extended_price])
		formatString: \$#,0;-\$#,0
		displayFolder: Adjustments
		lineageTag: d7af9259-22fb-5767-b0d9-4f828a1eb0b3

	measure 'Adj Extended Cost' = SUM('fact_price_adjustment'[extended_cost])
		formatString: \$#,0;-\$#,0
		displayFolder: Adjustments
		lineageTag: 3e63ecb5-c3fe-5061-8516-48d1579e838d

	measure 'Adj Primary Qty Ordered' = SUM('fact_price_adjustment'[primary_quantity_ordered])
		formatString: #,0.00
		displayFolder: Adjustments
		lineageTag: cc080be5-6f61-5551-ac63-48d2bcb2a764

	measure 'Adj Quantity Shipped Tons' = SUM('fact_price_adjustment'[quantity_shipped_tons])
		formatString: #,0.00
		displayFolder: Adjustments
		lineageTag: 71dda703-741b-546c-b5b6-e75df600437b

	measure 'Adj Ordered Tons' = SUM('fact_price_adjustment'[transaction_quantity_tons])
		formatString: #,0.00
		displayFolder: Adjustments
		lineageTag: e48169fa-8c80-5a15-94ad-ec5957634c1a

	measure 'Price Per Ton' = DIVIDE([Adj Extended Price], [Adj Ordered Tons])
		formatString: \$#,0.00
		displayFolder: Adjustments
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f60

	/// SOP000x Next-Status 620 adjustment buckets. ASSUMPTION: value = adj_unit_price (ALUPRC) and the ALAST->bucket split below — confirm both against the Hubble/report DAX.
	measure 'Adj Non Product' = CALCULATE(SUM('fact_price_adjustment'[adj_unit_price]), 'fact_price_adjustment'[price_adjustment_type] IN {"PPSLB", "CASLB"})
		formatString: \$#,0.00
		displayFolder: Adjustment Buckets
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f61

	measure 'Adj AL Severance Tax' = CALCULATE(SUM('fact_price_adjustment'[adj_unit_price]), 'fact_price_adjustment'[price_adjustment_type] IN {"ALST", "A03"})
		formatString: \$#,0.00
		displayFolder: Adjustment Buckets
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f62

	measure 'Adj Misc Billing' = CALCULATE(SUM('fact_price_adjustment'[adj_unit_price]), 'fact_price_adjustment'[price_adjustment_type] IN {"PP06", "PP07", "PP08", "PP13", "PP15", "PP17", "PP26", "PP37", "PP50", "PP51", "PP56", "PP57", "PP97", "PP99"})
		formatString: \$#,0.00
		displayFolder: Adjustment Buckets
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f63

	measure 'Adj Freight' = CALCULATE(SUM('fact_price_adjustment'[adj_unit_price]), 'fact_price_adjustment'[price_adjustment_type] IN {"FRTTAXN", "FRTTAXY"})
		formatString: \$#,0.00
		displayFolder: Adjustment Buckets
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f64

	measure 'Adj Car Charges' = CALCULATE(SUM('fact_price_adjustment'[adj_unit_price]), 'fact_price_adjustment'[price_adjustment_type] IN {"COLPALN", "COLPALT"})
		formatString: \$#,0.00
		displayFolder: Adjustment Buckets
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f65

	measure 'Adj Freight Hide' = CALCULATE(SUM('fact_price_adjustment'[adj_unit_price]), 'fact_price_adjustment'[price_adjustment_type] IN {"FRTHIDE"})
		formatString: \$#,0.00
		displayFolder: Adjustment Buckets
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f66

