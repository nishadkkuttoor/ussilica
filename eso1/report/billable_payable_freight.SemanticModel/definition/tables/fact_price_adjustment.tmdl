table fact_price_adjustment
	lineageTag: c1a4401c-abc0-5b2d-962d-36bcf574f807

	measure 'Total Tons' = SUMX('fact_sales_order_freight', 'fact_sales_order_freight'[transaction_quantity] * COALESCE('fact_sales_order_freight'[conversion_to_tons_rate], 0))
		formatString: #,0.00
		displayFolder: Price Adjustment
		lineageTag: f5af3782-2b89-571b-b06a-db95f262566a

	measure 'Product Price' = SUMX(FILTER('fact_sales_order_freight', NOT(TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT")), 'fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 82b231f4-ce01-5fda-83ba-d1e22d799086

	measure 'Price Per Ton' = DIVIDE([Product Price], [Total Tons])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: e0010b32-d04e-5ade-8f2c-d876f5452a89

	measure 'Deferred Revenue' = SUMX(FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[deferred_entries_flag]) <> ""), 'fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: a148102f-f077-5f99-ad83-dc8c7493ca26

	measure 'Freight' = SUMX(FILTER('fact_sales_order_freight', (TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT") && (LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "BIL" || LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "FRE" || LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "FUE" || LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "TRA")), 'fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: dc0a079e-7595-5a37-a896-98c5511c98a4

	measure 'Car Charges' = SUMX(FILTER('fact_sales_order_freight', (TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT") && LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "RAI"), 'fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: d869e38b-69b7-5823-9865-fe80e270912d

	measure 'Non Product' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[adj_print_code]) = "NON"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 3c4db27e-2532-5e10-b3f0-6c3d254f9fc7

	measure 'AL Severance Tax' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[adj_print_code]) = "ALA"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 2a74283d-11f1-5e4d-93cf-f746ab22cfe1

	measure 'Misc Billing' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[adj_print_code]) = "ACR" || LEFT(TRIM('fact_price_adjustment'[price_adjustment_type]), 2) = "PP"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: fe33913b-5715-57ee-a387-372f94f2f6b1

	measure 'Freight Hide' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[price_adjustment_type]) = "FRTHIDE"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 4201fa63-1d27-5483-8426-d12810ec706d

	measure 'Dryer Freight Charge' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[price_adjustment_type]) = "EPDELFRT"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: b0535f60-37d4-5a6c-afbb-e5f05a43b256

	measure 'Sales Amount' = SUM('fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 899f0241-dbca-56c5-8053-7df158e1b90a

	measure 'Extended Cost' = SUM('fact_sales_order_freight'[extended_cost])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: a88c7ef2-08ce-54cc-9784-508a28d47a31

