table fact_price_adjustment
	lineageTag: c1a4401c-abc0-5b2d-962d-36bcf574f807

	measure 'Total Tons' = SUMX('fact_sales_order_freight', 'fact_sales_order_freight'[transaction_quantity] * COALESCE(IF(TRIM('fact_sales_order_freight'[uom]) = "TN", 1.0), RELATED(dim_uom_conversion_item[conv_factor]), RELATED(dim_uom_conversion[std_factor]), 0))
		formatString: #,0.00
		displayFolder: Price Adjustment
		lineageTag: f5af3782-2b89-571b-b06a-db95f262566a

	measure 'Total Tons (Product)' = SUMX(FILTER('fact_sales_order_freight', NOT(TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT")), 'fact_sales_order_freight'[transaction_quantity] * COALESCE(IF(TRIM('fact_sales_order_freight'[uom]) = "TN", 1.0), RELATED(dim_uom_conversion_item[conv_factor]), RELATED(dim_uom_conversion[std_factor]), 0))
		formatString: #,0.00
		displayFolder: Price Adjustment
		lineageTag: 6b941403-6d35-5b9a-85cf-06fe3b348b60

	measure 'Product Price' = SUMX(FILTER('fact_sales_order_freight', NOT(TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT")), 'fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 82b231f4-ce01-5fda-83ba-d1e22d799086

	measure 'Product Price (Product)' = SUMX(FILTER('fact_sales_order_freight', NOT(TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT")), 'fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 5839bd46-8ce4-55b7-861c-ba5a0fd41fee

	measure 'Price Per Ton' = DIVIDE([Product Price], [Total Tons])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: e0010b32-d04e-5ade-8f2c-d876f5452a89

	measure 'Price Per Ton (Product)' = DIVIDE([Product Price (Product)], [Total Tons (Product)])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: f8ed2c85-2b7e-590e-b33c-b26471b192fe

	measure 'Deferred Revenue' = SUMX(FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[deferred_entries_flag]) <> ""), 'fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: a148102f-f077-5f99-ad83-dc8c7493ca26

	measure 'Freight' = SUMX(FILTER('fact_sales_order_freight', (TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT") && (LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "BIL" || LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "FRE" || LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "FUE" || LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "TRA")), 'fact_sales_order_freight'[extended_price]) + SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[price_adjustment_type]) = "FRTTAXN" || TRIM('fact_price_adjustment'[price_adjustment_type]) = "FRTTAXY"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: dc0a079e-7595-5a37-a896-98c5511c98a4

	measure 'Car Charges' = SUMX(FILTER('fact_sales_order_freight', (TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT") && LEFT(TRIM('fact_sales_order_freight'[third_item_number]), 3) = "RAI"), 'fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: d869e38b-69b7-5823-9865-fe80e270912d

	measure 'Non Product' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[adj_print_code]) = "NON"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 3c4db27e-2532-5e10-b3f0-6c3d254f9fc7

	measure 'AL Severance Tax' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[adj_print_code]) = "ALA"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 2a74283d-11f1-5e4d-93cf-f746ab22cfe1

	measure 'Misc Billing' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[adj_print_code]) = "ACR" || LEFT(TRIM('fact_price_adjustment'[price_adjustment_type]), 2) = "PP"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: fe33913b-5715-57ee-a387-372f94f2f6b1

	measure 'Freight Hide' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[price_adjustment_type]) = "FRTHIDE"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 4201fa63-1d27-5483-8426-d12810ec706d

	measure 'Dryer Freight Charge' = SUMX(FILTER('fact_price_adjustment', TRIM('fact_price_adjustment'[price_adjustment_type]) = "EPDELFRT"), 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0))
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: b0535f60-37d4-5a6c-afbb-e5f05a43b256

	measure 'Adj Product Price' = VAR FrtHide = SUMX(FILTER('fact_price_adjustment', 'fact_price_adjustment'[adj_based_on_value] <> 0 && 'fact_price_adjustment'[price_adjustment_type] = "FRTHIDE" && TRIM('fact_price_adjustment'[adj_uom]) = "TN"), VAR uomLine = RELATED('fact_sales_order_freight'[uom]) VAR convFactor = COALESCE(IF(TRIM(uomLine) = "TN", 1.0), LOOKUPVALUE(dim_uom_conversion_item[conv_factor], dim_uom_conversion_item[item_uom_key], RELATED('fact_sales_order_freight'[item_uom_key])), LOOKUPVALUE(dim_uom_conversion[std_factor], dim_uom_conversion[from_uom], uomLine), 0) RETURN - 'fact_price_adjustment'[adj_unit_price] * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0) * convFactor) VAR HasWhitelisted = COUNTROWS(FILTER('fact_price_adjustment', 'fact_price_adjustment'[adj_based_on_value] <> 0 && (LEFT('fact_price_adjustment'[price_adjustment_type], 2) = "PP" || 'fact_price_adjustment'[price_adjustment_type] = "A03" || 'fact_price_adjustment'[price_adjustment_type] = "CASLB" || 'fact_price_adjustment'[price_adjustment_type] = "FRTHIDE" || 'fact_price_adjustment'[price_adjustment_type] = "FRTTAXN" || 'fact_price_adjustment'[price_adjustment_type] = "FRTTAXY" || 'fact_price_adjustment'[price_adjustment_type] = "COLPALN" || 'fact_price_adjustment'[price_adjustment_type] = "COLPALT" || 'fact_price_adjustment'[price_adjustment_type] = "ALST"))) RETURN IF(HasWhitelisted > 0, FrtHide + 0, BLANK())
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: abd4861e-7dab-5984-b584-7385f73ca64c

	measure 'Sales Amount' = SUM('fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: 899f0241-dbca-56c5-8053-7df158e1b90a

	measure 'Extended Cost' = SUM('fact_sales_order_freight'[extended_cost])
		formatString: \$#,0.00
		displayFolder: Price Adjustment
		lineageTag: a88c7ef2-08ce-54cc-9784-508a28d47a31

	measure 'Price Value' = VAR rt = SELECTEDVALUE('Row Type'[Row Type]) RETURN SWITCH(rt, "Product Price", [Product Price], "Adjustment", [Adj Product Price], [Product Price] + [Adj Product Price])
		formatString: \$#,0.00;-\$#,0.00;
		displayFolder: Price Adjustment
		lineageTag: edaeb746-41d8-58ad-bb9d-6159cd1820b5

	measure 'Tons Value' = VAR rt = SELECTEDVALUE('Row Type'[Row Type]) RETURN SWITCH(rt, "Product Price", [Total Tons], "Adjustment", BLANK(), [Total Tons])
		formatString: #,0.00
		displayFolder: Price Adjustment
		lineageTag: bf8d719b-c680-50c6-aeb1-10b6380383c4

