table fact_sales_order_freight
	lineageTag: 20a80d3b-3396-5464-ac9e-ade34e283188

	measure 'Billable Freight' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[billable_freight])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 6d2fbe1b-c726-513d-8c2c-f7374f707d80

	measure 'Billable Fuel' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[billable_fuel])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: e9031740-81bd-58e7-81a7-dc2b7bc3dade

	measure 'Total Billable' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[total_billable])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 1735c533-0eed-5bd5-ae21-880300efd06a

	measure 'Payable Freight' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[payable_freight])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: b4d5405a-ac64-50eb-aa79-706917ea526f

	measure 'Payable Fuel' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[payable_fuel])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 25692a73-a4db-5f1f-9259-b96ecd7c2e20

	measure 'Total Payable' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[total_payable])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 3f869f7c-407c-5d6a-b6a8-a1c8b3d3d3b9

	measure 'Freight Variance' = [Billable Freight] - [Payable Freight]
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: eb1dd1aa-7129-529a-9f50-88909921a0a2

	measure 'Total Variance' = [Total Billable] - [Total Payable]
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: a8920616-f432-51d7-8ca8-b7edfbbe3c3a

	measure 'Freight CM %' = DIVIDE([Freight Variance], [Billable Freight])
		formatString: 0.0%
		displayFolder: Freight
		lineageTag: 8c1d22be-8113-50e5-92af-17979ef7d6bf

	measure 'Total CM %' = DIVIDE([Total Variance], [Total Billable])
		formatString: 0.0%
		displayFolder: Freight
		lineageTag: 9d04177b-bc5f-5877-8622-e53dbf9dd9ac

	measure 'Freight Shipments' = DISTINCTCOUNT('fact_sales_order_freight'[shipment_number])
		formatString: #,0
		displayFolder: Counts
		lineageTag: 836c7fe5-4129-5b16-9995-1a959050e34e

	measure 'Order Lines' = COUNTROWS('fact_sales_order_freight')
		formatString: #,0
		displayFolder: Counts
		lineageTag: 39e45523-26f0-5a9a-8438-f20f0992fab0

	measure 'Quantity Shipped Tons' = SUM('fact_sales_order_freight'[quantity_shipped_tons])
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: f7af5e3c-c811-5141-9a8b-43008c7bbab2

	measure 'Price Quantity Shipped' = SUM('fact_sales_order_freight'[price_quantity_shipped])
		formatString: \$#,0;-\$#,0
		displayFolder: Volume
		lineageTag: d9bbc0cd-401a-598e-8164-175fe1430762

	measure 'Lines Missing Conversion' = CALCULATE([Order Lines], 'fact_sales_order_freight'[missing_conversion_flag]="Y")
		formatString: #,0
		displayFolder: Quality
		lineageTag: 0b24db75-e200-59ec-a5a4-61799a6c4421

	measure 'Total Freight' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[total_freight])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f01

	measure 'Gross Weight' = SUM('fact_sales_order_freight'[gross_weight])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f02

	measure 'Catch Weight' = SUM('fact_sales_order_freight'[catch_weight])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f03

	measure 'Carrier Name' = SELECTEDVALUE(dim_address_carrier[address_number]) & " - " & SELECTEDVALUE(dim_address_carrier[name_alpha])
		displayFolder: Names
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f04

	measure 'Parent Name' = SELECTEDVALUE(dim_address_parent[address_number]) & " - " & SELECTEDVALUE(dim_address_parent[name_alpha])
		displayFolder: Names
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f05

	measure 'Days Past Due' = DATEDIFF(MAX('fact_sales_order_freight'[requested_date]), TODAY(), DAY)
		formatString: #,0
		displayFolder: Aging
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f06

	measure 'Ordered Tons' = SUMX('fact_sales_order_freight', 'fact_sales_order_freight'[transaction_quantity] * COALESCE('fact_sales_order_freight'[conversion_to_tons_rate], 0))
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: 5b1a7e60-1c2f-5a44-9e11-7a0c2d4e6f07

