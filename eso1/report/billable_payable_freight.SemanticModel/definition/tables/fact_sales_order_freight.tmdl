table fact_sales_order_freight
	lineageTag: 20a80d3b-3396-5464-ac9e-ade34e283188

	measure 'Billable Freight' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[billable_freight])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 6d2fbe1b-c726-513d-8c2c-f7374f707d80

	measure 'Billable Fuel' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[billable_fuel])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: e9031740-81bd-58e7-81a7-dc2b7bc3dade

	measure 'Total Billable' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[total_billable])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 1735c533-0eed-5bd5-ae21-880300efd06a

	measure 'Payable Freight' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[payable_freight])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: b4d5405a-ac64-50eb-aa79-706917ea526f

	measure 'Payable Fuel' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[payable_fuel])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 25692a73-a4db-5f1f-9259-b96ecd7c2e20

	measure 'Total Payable' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[total_payable])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 3f869f7c-407c-5d6a-b6a8-a1c8b3d3d3b9

	measure 'Freight Variance' = [Billable Freight] - [Payable Freight]
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: eb1dd1aa-7129-529a-9f50-88909921a0a2

	measure 'Total Variance' = [Total Billable] - [Total Payable]
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: a8920616-f432-51d7-8ca8-b7edfbbe3c3a

	measure 'Freight CM %' = DIVIDE([Freight Variance], [Billable Freight])
		formatString: 0.0%
		displayFolder: Freight
		lineageTag: 8c1d22be-8113-50e5-92af-17979ef7d6bf

	measure 'Total CM %' = DIVIDE([Total Variance], [Total Billable])
		formatString: 0.0%
		displayFolder: Freight
		lineageTag: 9d04177b-bc5f-5877-8622-e53dbf9dd9ac

	measure 'Freight Shipments' = DISTINCTCOUNT('fact_sales_order_freight'[shipment_number])
		formatString: #,0
		displayFolder: Counts
		lineageTag: 836c7fe5-4129-5b16-9995-1a959050e34e

	measure 'Order Lines' = COUNTROWS('fact_sales_order_freight')
		formatString: #,0
		displayFolder: Counts
		lineageTag: 39e45523-26f0-5a9a-8438-f20f0992fab0

	measure 'Quantity Shipped Tons' = SUM('fact_sales_order_freight'[quantity_shipped_tons])
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: f7af5e3c-c811-5141-9a8b-43008c7bbab2

	measure 'Price Quantity Shipped' = SUM('fact_sales_order_freight'[price_quantity_shipped])
		formatString: \$#,0;-\$#,0
		displayFolder: Volume
		lineageTag: d9bbc0cd-401a-598e-8164-175fe1430762

	measure 'Lines Missing Conversion' = CALCULATE([Order Lines], 'fact_sales_order_freight'[missing_conversion_flag]="Y")
		formatString: #,0
		displayFolder: Quality
		lineageTag: 0b24db75-e200-59ec-a5a4-61799a6c4421

	measure 'Total Freight' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[total_freight])))
		formatString: \$#,0;-\$#,0
		displayFolder: Freight
		lineageTag: 496d25de-487f-580f-95a6-998ece751644

	measure 'Gross Weight' = SUM('fact_sales_order_freight'[gross_weight])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 8a124861-b9dc-5f81-9a72-42f18f8ba950

	measure 'Catch Weight' = SUM('fact_sales_order_freight'[catch_weight])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 957c5b3c-f3f9-5c8e-b0da-4b5af68a81b8

	measure 'Carrier Name' = SELECTEDVALUE(dim_address_carrier[address_number]) & " - " & SELECTEDVALUE(dim_address_carrier[name_alpha])
		displayFolder: Names
		lineageTag: 8c13a510-0c37-5ee5-833a-e2c0bb65dca5

	measure 'Parent Name' = SELECTEDVALUE(dim_address_parent[address_number]) & " - " & SELECTEDVALUE(dim_address_parent[name_alpha])
		displayFolder: Names
		lineageTag: 8512832a-ae0f-5d26-8b89-5cfd944687b2

	measure 'Ocean Carrier Name' = SELECTEDVALUE(dim_address_ocean_carrier[address_number]) & " - " & SELECTEDVALUE(dim_address_ocean_carrier[name_alpha])
		displayFolder: Names
		lineageTag: 9a20d7ee-8359-562f-b14a-889a4de33f77

	measure 'Days Past Due' = DATEDIFF(MAX('fact_sales_order_freight'[requested_date]), TODAY(), DAY)
		formatString: #,0
		displayFolder: Aging
		lineageTag: c858c685-6699-5fcf-813e-21f9d693408b

	measure 'Ordered Tons' = SUMX('fact_sales_order_freight', 'fact_sales_order_freight'[transaction_quantity] * COALESCE('fact_sales_order_freight'[conversion_to_tons_rate], 0))
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: 0f5a8d12-4aa0-5589-830f-a8d94a3e33ed

	measure 'Container Count' = SUMX(VALUES('fact_sales_order_freight'[shipment_number]), CALCULATE(MAX('fact_sales_order_freight'[route_container_count])))
		formatString: #,0
		displayFolder: Volume
		lineageTag: 2c04dbae-acbb-5617-9262-1ad19053f004

	measure 'Product Price' = SUM('fact_sales_order_freight'[extended_price])
		formatString: \$#,0.00
		displayFolder: Pricing
		lineageTag: e798cec8-e286-5a35-ba25-d0f46e19dad1

	measure 'Price Per Ton' = DIVIDE([Product Price], [Quantity Shipped Tons])
		formatString: \$#,0.00
		displayFolder: Pricing
		lineageTag: 55fd1a5f-0405-5f4a-9828-da3f4ebb19f1

	measure 'Short Ship Shipped Qty' = SUM('fact_sales_order_freight'[quantity_shipped])
		formatString: #,0.00
		displayFolder: Short Ship
		lineageTag: 3853521b-7540-5324-82d5-edf00660226e

	measure 'Short Ship Ordered Qty' = SUM('fact_sales_order_freight'[primary_quantity_ordered])
		formatString: #,0.00
		displayFolder: Short Ship
		lineageTag: d6728036-9a86-5664-8479-c21ceeede313

	measure 'Short Ship Transaction Qty' = SUM('fact_sales_order_freight'[transaction_quantity])
		formatString: #,0.00
		displayFolder: Short Ship
		lineageTag: 0b6ccd3b-b301-53c6-9281-0b0bc8720982

	measure 'Short Ship Cancelled Qty' = SUM('fact_sales_order_freight'[cancelled_qty])
		formatString: #,0.00
		displayFolder: Short Ship
		lineageTag: 4b53bb29-c8d8-5c8b-94a0-d685e3a080b2

	measure 'Open Qty' = SUM('fact_sales_order_freight'[open_qty])
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: 7dcc726c-5314-51e5-b4f5-a59caf8c147b

	measure 'Order Qty' = SUM('fact_sales_order_freight'[transaction_quantity])
		formatString: #,0.00
		displayFolder: Quantities
		lineageTag: 4ea16d6f-ee07-5c5a-b2de-8342d218b93a

	measure 'Primary Qty Ordered' = SUM('fact_sales_order_freight'[primary_quantity_ordered])
		formatString: #,0.00
		displayFolder: Quantities
		lineageTag: 18658318-625f-5380-ac9f-4d6a10fec9a2

	measure 'Primary Qty Loaded' = SUM('fact_sales_order_freight'[quantity_shipped])
		formatString: #,0.00
		displayFolder: Quantities
		lineageTag: 968ccb8e-c915-58a7-84ae-f68cb7f73ace

	measure 'Primary Qty Open' = SUM('fact_sales_order_freight'[open_qty])
		formatString: #,0.00
		displayFolder: Quantities
		lineageTag: 89ee398e-c561-56ab-8034-db0da3effd74

	measure 'Days Since Cancel' = DATEDIFF(MAX('fact_sales_order_freight'[cancel_date]), TODAY(), DAY)
		formatString: #,0
		displayFolder: Short Ship
		lineageTag: 2ab6bc86-43aa-512b-be50-9d7b8c360861

	measure 'KG Ordered Qty' = SUMX(FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[uom]) = "KG"), 'fact_sales_order_freight'[transaction_quantity])
		formatString: #,0.00
		displayFolder: Ottawa Buckets
		lineageTag: 6ef491d2-8532-5744-a66e-b373f984a540

	measure 'KG Line Count' = COUNTROWS(FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[uom]) = "KG")) + 0
		formatString: #,0
		displayFolder: Ottawa Buckets
		lineageTag: e43f1eb7-dd41-5b10-a5f0-9554d0521b13

	measure 'Freight-Type Ordered Qty' = SUMX(FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT" || TRIM('fact_sales_order_freight'[line_type]) = "CA"), 'fact_sales_order_freight'[primary_quantity_ordered])
		formatString: #,0.00
		displayFolder: Ottawa Buckets
		lineageTag: 282c128a-ef1c-59c1-8c5c-ce2d68494bf7

	measure 'Freight-Type Line Count' = COUNTROWS(FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[line_type]) = "F" || TRIM('fact_sales_order_freight'[line_type]) = "FT" || TRIM('fact_sales_order_freight'[line_type]) = "CA")) + 0
		formatString: #,0
		displayFolder: Ottawa Buckets
		lineageTag: 54877308-4bd6-5ce7-8fc5-30cab952bb39

	measure 'Confirmed Ordered Qty' = SUMX(FILTER('fact_sales_order_freight', 'fact_sales_order_freight'[last_status_num] = 530 && 'fact_sales_order_freight'[next_status_num] = 560), 'fact_sales_order_freight'[primary_quantity_ordered])
		formatString: #,0.00
		displayFolder: Ottawa Buckets
		lineageTag: 717c98c5-5cfc-574b-94d1-350a38a153bb

	measure 'Confirmed Line Count' = COUNTROWS(FILTER('fact_sales_order_freight', 'fact_sales_order_freight'[last_status_num] = 530 && 'fact_sales_order_freight'[next_status_num] = 560)) + 0
		formatString: #,0
		displayFolder: Ottawa Buckets
		lineageTag: fb495943-8722-5b19-971d-07f892c9a862

	measure 'Backorder Ordered Qty' = SUMX(FILTER('fact_sales_order_freight', 'fact_sales_order_freight'[last_status_num] = 520 || 'fact_sales_order_freight'[last_status_num] = 914), 'fact_sales_order_freight'[primary_quantity_ordered])
		formatString: #,0.00
		displayFolder: Ottawa Buckets
		lineageTag: b72c9afe-ba61-5a33-9465-cd1a4be749fb

	measure 'Backorder Line Count' = COUNTROWS(FILTER('fact_sales_order_freight', 'fact_sales_order_freight'[last_status_num] = 520 || 'fact_sales_order_freight'[last_status_num] = 914)) + 0
		formatString: #,0
		displayFolder: Ottawa Buckets
		lineageTag: 041e4e75-e3b7-524f-b45d-2255ffbdc26c

