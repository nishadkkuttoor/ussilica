	/// District code and description combined.
	measure display_district =
			
			VAR _code = SELECTEDVALUE ( fact_extended_sales_order_5[district] )
			RETURN
			    IF (
			        NOT ISBLANK ( _code ),
			        _code & " - "
			            & LOOKUPVALUE ( dim_plant[plant_name],
			                            dim_plant[plant_code], _code )
			    )
		lineageTag: ec615e73-a832-495f-bfbe-cd8a783b8066

	/// sold_to and its name_alpha from dim_address_book_sold_to concatenated
	measure display_customer =
			
			VAR _code = SELECTEDVALUE ( fact_extended_sales_order_5[sold_to] )
			RETURN
			    IF (
			        NOT ISBLANK ( _code ),
			        _code & " - "
			            & LOOKUPVALUE ( dim_address_book_sold_to[name_alpha],
			                            dim_address_book_sold_to[address_number], _code )
			    )
		lineageTag: af8c5007-5efb-4c12-868c-47f320f71eeb

	/// Carrier code and its description combined.
	measure display_carrier =
			
			VAR _code = SELECTEDVALUE ( fact_extended_sales_order_5[carrier] )
			RETURN
			    IF (
			        NOT ISBLANK ( _code ),
			        _code & " - "
			            & LOOKUPVALUE ( dim_address_book_carrier[name_alpha],
			                            dim_address_book_carrier[address_number], _code )
			    )
		lineageTag: a00b6041-b57c-4274-9ee9-bb40924e6a98

	/// shipt_to from fact_extended_sales_order_5 and its name_alpha from dim_address_book_ship_to field combined.
	measure 'display_ship to' =
			
