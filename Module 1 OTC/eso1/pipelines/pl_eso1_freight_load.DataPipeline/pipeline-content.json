{
  "properties": {
    "description": "ESO1 Billable v Payable Freight — near-real-time load. Runs the two current-state fact notebooks in parallel every 5 minutes (incremental MERGE), then the dim_shipment bridge (built from both facts). Shared high-concurrency Spark session (sessionTag) cuts startup cost; pipeline concurrency = 1 prevents overlapping runs.",
    "activities": [
      {
        "name": "run_fact_sales_order_line",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:20:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "<NB_FACT_SALES_ORDER_LINE_GUID>",
          "workspaceId": "<WORKSPACE_GUID>",
          "sessionTag": "eso1_nrt"
        }
      },
      {
        "name": "run_fact_freight_audit",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:20:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "<NB_FACT_FREIGHT_AUDIT_GUID>",
          "workspaceId": "<WORKSPACE_GUID>",
          "sessionTag": "eso1_nrt"
        }
      },
      {
        "name": "run_dim_shipment",
        "type": "TridentNotebook",
        "dependsOn": [
          { "activity": "run_fact_sales_order_line", "dependencyConditions": ["Succeeded"] },
          { "activity": "run_fact_freight_audit",    "dependencyConditions": ["Succeeded"] }
        ],
        "policy": {
          "timeout": "0.00:15:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "<NB_DIM_SHIPMENT_GUID>",
          "workspaceId": "<WORKSPACE_GUID>",
          "sessionTag": "eso1_nrt"
        }
      }
    ],
    "concurrency": 1,
    "annotations": ["eso1", "billable-payable-freight", "near-real-time"]
  }
}
