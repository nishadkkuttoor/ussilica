table fact_sales_order_line
	lineageTag: 7aca2463-bcf2-504b-8d82-cf5e44c1b257

	measure 'Total Tons' = CALCULATE(SUM(fact_sales_order_line[units_transaction_qty_tons]), fact_sales_order_line[is_deleted]=FALSE())
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: 63a685bd-df2d-58ae-9b6c-58e2a5bd563e

	measure 'Quantity Shipped Tons' = CALCULATE(SUM(fact_sales_order_line[quantity_shipped_tons]), fact_sales_order_line[is_deleted]=FALSE())
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: 50ea0076-ca1e-5ce9-bbbc-649f6c76234e

	measure 'Open Tons' = CALCULATE(SUM(fact_sales_order_line[units_open_tons]), fact_sales_order_line[is_deleted]=FALSE())
		formatString: #,0.00
		displayFolder: Volume
		lineageTag: d4d5351a-32c0-53c5-92cb-512c6e8e216d

	measure 'Revenue $' = CALCULATE(SUM(fact_sales_order_line[revenue_dollars]), fact_sales_order_line[is_deleted]=FALSE())
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Margin
		lineageTag: 903116d2-e855-553d-a658-ea5ebdef088d

	measure 'Cost $' = CALCULATE(SUMX(fact_sales_order_line, fact_sales_order_line[item_unit_cost] * fact_sales_order_line[units_transaction_qty_tons]), fact_sales_order_line[is_deleted]=FALSE())
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Margin
		lineageTag: 549f97b1-866e-5c8a-ba39-5aece85b851e

	measure 'Margin $' = [Revenue $] - [Cost $]
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Margin
		lineageTag: 25a896cd-50e6-5add-95d0-f097183e5725

	measure 'Margin %' = DIVIDE([Margin $], [Revenue $])
		formatString: 0.0%
		displayFolder: Margin
		lineageTag: 38150c39-197c-5cfa-849b-a86af37e171c

	measure 'Order Lines' = CALCULATE(DISTINCTCOUNT(fact_sales_order_line[order_line_key]), fact_sales_order_line[is_deleted]=FALSE())
		formatString: #,0
		displayFolder: Counts
		lineageTag: 4fbc02e5-336c-5f3f-aa64-4fe1f5898e4e

	measure 'Lines Missing Conversion' = CALCULATE([Order Lines], fact_sales_order_line[missing_conversion_flag]="Y")
		formatString: #,0
		displayFolder: Quality
		lineageTag: 7da9d008-7381-574f-bff4-1a7caffee131

	measure '% High-Confidence Cost' = DIVIDE(CALCULATE([Order Lines], fact_sales_order_line[cost_confidence]="HIGH"), [Order Lines])
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: 89cb85dd-2cc2-539f-b0f0-1bdbcc8ca906

