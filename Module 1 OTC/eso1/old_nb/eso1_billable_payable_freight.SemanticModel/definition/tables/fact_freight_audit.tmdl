table fact_freight_audit
	lineageTag: 52a0e749-ef66-51a8-8421-63aa692871b8

	measure 'Billable Freight' = CALCULATE(SUM(fact_freight_audit[billable_freight]), fact_freight_audit[is_deleted]=FALSE())
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Freight
		lineageTag: 95743e21-e557-5439-8e23-44db2a39d7db

	measure 'Billable Fuel' = CALCULATE(SUM(fact_freight_audit[billable_fuel]), fact_freight_audit[is_deleted]=FALSE())
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Freight
		lineageTag: fff890fd-c31f-565c-868e-0e3954edabc8

	measure 'Total Billable' = CALCULATE(SUM(fact_freight_audit[total_billable]), fact_freight_audit[is_deleted]=FALSE())
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Freight
		lineageTag: 4264434d-6865-5816-bc8f-c045dd24764e

	measure 'Payable Freight' = CALCULATE(SUM(fact_freight_audit[payable_freight]), fact_freight_audit[is_deleted]=FALSE())
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Freight
		lineageTag: a43e7600-d8b6-5e6c-8f1b-5a52ec84557c

	measure 'Payable Fuel' = CALCULATE(SUM(fact_freight_audit[payable_fuel]), fact_freight_audit[is_deleted]=FALSE())
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Freight
		lineageTag: aadd5cc4-de7d-5d85-8b8c-b019ba5d3465

	measure 'Total Payable' = CALCULATE(SUM(fact_freight_audit[total_payable]), fact_freight_audit[is_deleted]=FALSE())
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Freight
		lineageTag: daa2447f-212e-5399-bc58-4f85f386ecdf

	measure 'Freight Variance' = [Billable Freight] - [Payable Freight]
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Freight
		lineageTag: 83059df3-eeb0-502f-b092-a7bb3fa9d13a

	measure 'Total Variance' = [Total Billable] - [Total Payable]
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Freight
		lineageTag: aca07dd1-98aa-5a8a-b764-1d8f35b2e43e

	measure 'Freight CM %' = DIVIDE([Freight Variance], [Billable Freight])
		formatString: 0.0%
		displayFolder: Freight
		lineageTag: 76d73bb9-a460-5dd2-85ba-00f7af07f921

	measure 'Total CM %' = DIVIDE([Total Variance], [Total Billable])
		formatString: 0.0%
		displayFolder: Freight
		lineageTag: beae7fe2-1e3e-5654-b08c-5c86cd6eaefe

	measure 'Freight Shipments' = CALCULATE(DISTINCTCOUNT(fact_freight_audit[shipment_number]), fact_freight_audit[is_deleted]=FALSE())
		formatString: #,0
		displayFolder: Counts
		lineageTag: ea59c47f-b519-5e8b-8d43-1e4738eb421a

