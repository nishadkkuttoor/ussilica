table measure_tbl
	lineageTag: 72f42fb3-cf01-47c5-9e48-0e0a196087b9

	/// F4981 carrier-billed actual when the shipment has one, else the F4074 line estimate (sum of adj_unit_price x ordered tons).
	measure 'Billable Freight' =
			
			SUMX(
			    VALUES('fact_sales_order_freight'[shipment_number]),
			    VAR _actual = CALCULATE(MAX('fact_sales_order_freight'[billable_freight_actual]))
			    VAR _estimate =
			        CALCULATE(
			            SUMX(
			                FILTER('fact_price_adjustment',
			                    TRIM('fact_price_adjustment'[price_adjustment_type]) = "EPDELFRT" ||
			                    TRIM('fact_price_adjustment'[price_adjustment_type]) = "FRTHIDE"  ||
			                    TRIM('fact_price_adjustment'[price_adjustment_type]) = "FRTTAXY"  ||
			                    TRIM('fact_price_adjustment'[price_adjustment_type]) = "FRTTAXN"  ||
			                    TRIM('fact_price_adjustment'[price_adjustment_type]) = "FRTNBP"   ||
			                    TRIM('fact_price_adjustment'[price_adjustment_type]) = "POOLFSC"),
			                'fact_price_adjustment'[adj_unit_price]
			                    * COALESCE(RELATED('fact_sales_order_freight'[transaction_quantity]), 0)
			                    * COALESCE(RELATED('fact_sales_order_freight'[conversion_to_tons_rate]), 0)
			            )
			        )
			    RETURN IF(_actual <> 0, _actual, _estimate)
			)
		lineageTag: 8235c7a9-42f3-4758-8934-ca2bdfd5bcfd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Shipment-deduped billable fuel-surcharge bucket
	measure 'Billable Fuel' =
			
			SUMX(VALUES(fact_sales_order_freight[shipment_number]), CALCULATE(MAX(fact_sales_order_freight[billable_fuel])))
		lineageTag: 3032d288-437f-4431-b1d5-160fc77894fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Billable freight + billable fuel (measure-summed, mixed grain).
	measure 'Total Billable' = [Billable Freight] + [Billable Fuel]
		lineageTag: 5254d888-fc2a-4c21-9ec0-caf3e8465a0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Shipment-deduped payable freight bucket.
	measure 'Payable Freight' =
			
			SUMX(VALUES(fact_sales_order_freight[shipment_number]), CALCULATE(MAX(fact_sales_order_freight[payable_freight])))
		lineageTag: 3490e6bd-bac7-4c2c-a799-b1d48deb601f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Shipment-deduped payable fuel-surcharge bucket.
	measure 'Payable Fuel' =
			
			SUMX(VALUES(fact_sales_order_freight[shipment_number]), CALCULATE(MAX(fact_sales_order_freight[payable_fuel])))
		lineageTag: bf561295-0261-4256-bbd6-ccb102f2e668

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Shipment-deduped total payable (freight + fuel).
	measure 'Total Payable' =
			SUMX(VALUES('fact_sales_order_freight'[shipment_number]),
			     CALCULATE(MAX('fact_sales_order_freight'[total_payable])))
		lineageTag: bfa85383-895b-4128-b6ca-99f75604f24b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Shipment-deduped all-charge-code freight total (raw FHNAMT).
	measure 'Total Freight' =
			SUMX(VALUES('fact_sales_order_freight'[shipment_number]),
			     CALCULATE(MAX('fact_sales_order_freight'[total_freight])))
		lineageTag: 0d7fe517-5c9b-4510-b998-597fee15ac61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Billable minus payable freight.
	measure 'Freight Variance' = [Billable Freight] - [Payable Freight]
		lineageTag: a14e8ee5-32e8-4a22-9154-a093c3d7d441

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total billable minus total payable.
	measure 'Total Variance' = [Total Billable] - [Total Payable]
		lineageTag: 9cb6d70d-c167-4735-9f62-ae51a9fd5e88

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Freight variance / billable freight.
	measure 'Freight CM %' = DIVIDE([Freight Variance], [Billable Freight])
		formatString: 0.00
		lineageTag: 300bc722-601c-406e-8afa-e422db594237

		changedProperty = Name

	/// Total variance / total billable.
	measure 'Total CM %' = DIVIDE([Total Variance], [Total Billable])
		formatString: 0.00
		lineageTag: 945a3447-a185-4552-8393-789ec3ef3be3

	/// Distinct shipment count.
	measure 'Freight Shipments' = DISTINCTCOUNT('fact_sales_order_freight'[shipment_number])
		formatString: 0
		lineageTag: 315875ab-caa6-400e-85fa-7d61218d6d99

	/// Shipped qty x UOM->TN cascade (item factor -> std factor -> 0).
	measure 'Quantity Shipped Tons' =
			
			SUMX(
			    'fact_sales_order_freight',
			    'fact_sales_order_freight'[quantity_shipped]
			        * COALESCE(
			            RELATED(dim_uom_conversion_item[conv_factor]),
			            RELATED(dim_uom_conversion[std_factor]),
			            0
			        )
			)
		formatString: 0.00
		lineageTag: b1628e27-cfb7-44db-ad05-3920e818a38a

	/// Sum of the precomputed price x qty $ column
	measure 'Price Quantity Shipped' = SUM(fact_sales_order_freight[price_quantity_shipped])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 73733ea4-d9db-49e1-9815-4d5c75e04694

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Count of lines with no UOM->TN factor
	measure 'Lines Missing Conversion' = CALCULATE(COUNTROWS(fact_sales_order_freight), fact_sales_order_freight[missing_conversion_flag] = "Y")
		formatString: 0
		lineageTag: 0b7b83cc-21a8-4d4c-a630-2e1ecc438ea4

	/// Sum of BOL catch (actual scaled) weight
	measure 'Catch Weight' = SUM(fact_sales_order_freight[catch_weight])
		formatString: 0
		lineageTag: 872fa011-4112-4cb1-8629-96f50cad3812

	/// Sales-order line row count.
	measure 'Order Lines' = COUNTROWS(fact_sales_order_freight)
		formatString: 0
		lineageTag: ad9aad88-003b-41d4-8438-127483fc1eb5

	/// Distinct orders on a shipment. "Shipment with Multiple Orders – Scheduler": shipment_number on axis, visual-level filter > 1 to show consolidated shipments.
	measure 'Orders per Shipment' = DISTINCTCOUNT(fact_sales_order_freight[shipment_number])
		formatString: 0
		lineageTag: ff2b7f06-2865-4f26-ac4d-f80942a145df

	/// Distinct shipments for an order. Used on the "Order with Multiple Shipments – Scheduler" report: put order_number on the axis, this measure as value, and a visual-level filter > 1 to show orders split across shipments.
	measure 'Shipments per Order' = ```
			DISTINCTCOUNT(fact_sales_order_freight[shipment_number]) 
			```
		formatString: 0
		lineageTag: bb5ee4b6-8b08-4fc8-84e2-b0452252feec

	/// Days from latest invoice date to today (live).
	measure 'Days Since Last Invoice' =
			VAR AsOf = TODAY()
			VAR ReqD = MAX('fact_sales_order_freight'[invoice_date])
			RETURN
			    IF( NOT ISBLANK(ReqD), INT( AsOf - ReqD ) )
		formatString: 0
		lineageTag: 2273b83a-6c80-4b7f-84af-e180043fdc05

	/// Sum of ordered transaction quantity (SDUORG). The real metric behind the legacy GET_HASH_VALUE RowID sums on Standridge / Sto Corp / Thai Tan / Tri-Iso (those hashsums were just distinct-count helpers → DISTINCTCOUNT).
	measure 'Transaction Quantity' = SUM(fact_sales_order_freight[transaction_quantity])
		formatString: 0.00
		lineageTag: 8766d13d-2bcc-40b3-8f6a-fb5be72bf74d

	/// Plain sum of shipped quantity.
	measure 'Order Quantity' = SUM(fact_sales_order_freight[quantity_shipped])
		lineageTag: e3e61cec-84d9-4f91-bf4f-467bfeecf4a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sums the primary_quantity_ordered from fact_sales_order_freight to return the total ordered quantity for the current filter context.
	measure 'Ordered Quantity Total' = SUM(fact_sales_order_freight[primary_quantity_ordered])
		lineageTag: 91f945bd-8e0b-435f-9c27-89e0683caf43

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the total dollar amount of sales order freight by summing the extended price.
	measure 'Dollar Total' = SUM(fact_sales_order_freight[extended_price])
		lineageTag: 3e52a86a-d28f-46fd-9553-e9339ed0da21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of primary ordered quantity
	measure 'Primary Quantity Ordered' = SUM(fact_sales_order_freight[primary_quantity_ordered])
		lineageTag: 5ca6eaf3-5b61-445c-8d02-f5d75315134b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Days from requested date to today (live, positive = overdue).
	measure 'Days Past Due' =
			
			VAR AsOf = TODAY()
			VAR ReqD = MAX('fact_sales_order_freight'[requested_date])
			RETURN
			    IF( NOT ISBLANK(ReqD), INT( AsOf - ReqD ) )
		formatString: 0
		lineageTag: 9c219d8d-c162-449c-a2aa-f06ed78c88bf

	/// The blended average selling price per ordered unit across the current filter context
	measure 'Price Per Unit' = DIVIDE ( SUM ( fact_sales_order_freight[extended_price] ), SUM ( fact_sales_order_freight[transaction_quantity] ) )
		lineageTag: e371e2d0-5fc1-4d9b-9017-bd5176bd1cb7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Plain sum of shipped quantity.
	measure 'Quantity Shipped' = SUM ( fact_sales_order_freight[quantity_shipped] )
		lineageTag: bd6e09a4-5be5-491d-af46-3b989180984c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Unshipped quantity remaining = Ordered − Loaded.
	measure 'Quantity Open' = [Transaction Quantity] - [Quantity Shipped]
		lineageTag: df331872-8a5e-4993-9e71-3585948f8ef0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Row Count Test' = COUNTROWS ( fact_sales_order_freight )
		formatString: 0
		lineageTag: 47841d72-c053-4872-80e8-34c03ec7f734

	/// Converted to Short Tons - Ordered quantity expressed in short tons, summed per line across the current filter
	measure 'Converted to Short Tons' =
			
			SUMX (
			    fact_sales_order_freight,
			    fact_sales_order_freight[transaction_quantity] * fact_sales_order_freight[conversion_to_tons_rate]
			)
		lineageTag: 2421300e-3327-4ed8-be05-88488eae2d21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total ordered volume converted to short tons, using the pre-computed conversion_to_tons_rate fact column (which already encodes TN→1.0 plus the F41002 item factor), falling back to the standard F41003 factor, and finally to 1 when nothing resolves. For each line it multiplies ordered quantity (SDUORG) by that factor and sums.
	measure 'Tons Conv.' =
			
			SUMX(
			    fact_sales_order_freight,
			    fact_sales_order_freight[transaction_quantity]
			        * COALESCE(
			            fact_sales_order_freight[conversion_to_tons_rate],
			            RELATED(dim_uom_conversion[std_factor]),
			            1
			        )
			)
		lineageTag: 8b7b3d5b-8795-4fd4-86de-f5e7257fe948

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Fact-anchored current date (renders per-row in Direct Lake; blank if no requested date).
	measure Today =
			
			VAR d = MAX('fact_sales_order_freight'[requested_date])
			RETURN IF(NOT ISBLANK(d), FORMAT(TODAY(), "MM-dd-yyyy"))
		lineageTag: 989a2c2c-ca80-4923-883e-4d7bf3c519b8

	/// the quantity that was cancelled on a sales-order line
	measure 'Cancelled Qty' = SUM('fact_sales_order_freight'[cancelled_qty])
		lineageTag: 422296fd-fb55-437f-99ee-734b7b44630e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of open (unshipped) primary quantity (SDUOPN).
	measure 'Open Qty' = ```
			SUM('fact_sales_order_freight'[open_qty]) 
			```
		lineageTag: 68e88d33-4eb2-4ce2-b040-a038802077a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total ordered volume converted to short tons across all lines in context. For each line it multiplies ordered quantity (F4211 SDUORG) by a UOM→TN factor chosen from a four-step cascade — TN pass-through (1.0) → item-specific factor (F41002) → standard factor (F41003) → 0 — then sums with SUMX. Lines that can't be converted fall to 0 tons (dropped from the total), so the result is unit-consistent.
	measure 'Tons Conv Total' = ```
			
			SUMX('fact_sales_order_freight',
			    'fact_sales_order_freight'[transaction_quantity]
			      * COALESCE(
			            IF(TRIM('fact_sales_order_freight'[uom]) = "TN", 1.0),
			            RELATED(dim_uom_conversion_item[conv_factor]),
			            RELATED(dim_uom_conversion[std_factor]),
			            0))
			
			```
		lineageTag: 414766b4-6973-4fa3-ac9a-fd9ff5dc686a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ordered qty on confirmed lines (last=530 & next=560).
	measure 'Confirmed Ordered Qty' = SUMX(FILTER('fact_sales_order_freight', 'fact_sales_order_freight'[last_status_num] = 530 && 'fact_sales_order_freight'[next_status_num] = 560), 'fact_sales_order_freight'[primary_quantity_ordered])
		lineageTag: aab258e1-5fad-4670-b60c-441019780c3b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ordered qty on backorder lines (last 520 or 914).
	measure 'Backorder Ordered Qty' = SUMX(FILTER('fact_sales_order_freight', 'fact_sales_order_freight'[last_status_num] = 520 || 'fact_sales_order_freight'[last_status_num] = 914), 'fact_sales_order_freight'[primary_quantity_ordered])
		lineageTag: 86cc9f82-3561-4a60-a254-6e83c2d6cc00

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Product price / total tons.
	measure 'Price Per Ton' = DIVIDE([Product Price], [Tons Conv.])
		lineageTag: 29752d33-7a36-411b-9304-22152bd970e6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ordered volume, in short tons, contributed by the lines that were not originally in TN (so they had to be converted).
	measure 'Not TN Converted to Short Tons' =
			
			SUMX(
			    FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[uom]) <> "TN"),
			    'fact_sales_order_freight'[transaction_quantity]
			      * COALESCE('fact_sales_order_freight'[conversion_to_tons_rate], 0)
			)
		lineageTag: 71cdc564-badf-4562-82d9-4716e863691a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total ordered quantity from only the lines whose original order UOM is already short tons (TN)
	measure 'Is TN Original UoM Short Tons' =
			
			SUMX(
			    FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[uom]) = "TN"),
			    'fact_sales_order_freight'[transaction_quantity]
			)
		lineageTag: 2c46fde2-cd6b-4a29-b6da-944ba88fc4f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Latest invoice date.
	measure 'Last Invoice Date' = MAX('fact_sales_order_freight'[invoice_date])
		formatString: General Date
		lineageTag: b3e3c60c-094f-4333-9402-f826c646f9a6

	/// F4941 container count, deduped per shipment.
	measure 'Container Count' =
			SUMX(
			    VALUES('fact_sales_order_freight'[shipment_number]),
			    CALCULATE(MAX('fact_sales_order_freight'[route_container_count]))
			)
		lineageTag: 98264898-5a05-4e11-97f7-c104b06bfa9d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ordered qty on lines requested within 2 days forward (rd - today <= 2).
	measure 'AGE of NPO Any To 2' =
			
			SUMX('fact_sales_order_freight',
			     VAR rd = 'fact_sales_order_freight'[requested_date]
			     VAR a  = IF(NOT ISBLANK(rd), INT(rd - TODAY()))
			     RETURN IF(NOT ISBLANK(a) && a <= 2, 'fact_sales_order_freight'[transaction_quantity]))
		lineageTag: 3c3817de-1e9a-493e-926e-7b2b598fb4ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ordered qty on lines in the 3-5 day forward band.
	measure 'AGE of NPO 3 To 5' = ```
			SUMX('fact_sales_order_freight',                                                                                             
			       VAR rd = 'fact_sales_order_freight'[requested_date]
			       VAR a  = IF(NOT ISBLANK(rd), INT(rd - TODAY()))
			       RETURN IF(a >= 3 && a <= 5, 'fact_sales_order_freight'[transaction_quantity]))
			```
		lineageTag: 980e08a1-25a9-4087-bde9-29290fda1fe1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ordered qty on lines in the 6-14 day forward band.
	measure 'AGE of NPO 6 To 14' =
			
			SUMX('fact_sales_order_freight',
			     VAR rd = 'fact_sales_order_freight'[requested_date]
			     VAR a  = IF(NOT ISBLANK(rd), INT(rd - TODAY()))
			     RETURN IF(a >= 6 && a <= 14, 'fact_sales_order_freight'[transaction_quantity]))
		lineageTag: d0309359-b160-4003-bcf5-971262a93c2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ordered qty on lines 15+ days forward.
	measure 'AGE of NPO 15 To Any' =
			
			SUMX('fact_sales_order_freight',
			     VAR rd = 'fact_sales_order_freight'[requested_date]
			     VAR a  = IF(NOT ISBLANK(rd), INT(rd - TODAY()))
			     RETURN IF(a >= 15, 'fact_sales_order_freight'[transaction_quantity]))
		lineageTag: 653638e5-a5c7-498c-ac34-a9672653ca52

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Extended price on non-freight (non F/FT) lines.
	measure 'Product Price' =
			
			SUMX(
			    FILTER('fact_sales_order_freight',
			        NOT(TRIM('fact_sales_order_freight'[line_type]) = "F"
			         || TRIM('fact_sales_order_freight'[line_type]) = "FT")),
			    'fact_sales_order_freight'[extended_price]
			)
		lineageTag: ec6eb521-2427-4d9f-b6be-8102011275da

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ordered qty (SDUORG) x UOM->TN cascade.
	measure 'Ordered Tons (F41003)' =
			
			SUMX('fact_sales_order_freight',
			     'fact_sales_order_freight'[transaction_quantity]
			     * COALESCE(RELATED(dim_uom_conversion_item[conv_factor]),
			                RELATED(dim_uom_conversion[std_factor]), 0))
		lineageTag: cfbb8327-7f1a-4fd1-83c1-37a21e260c62

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ordered volume in short tons, limited to product (stock) lines only
	measure 'Product Tons' =
			SUMX(
			    FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[line_type]) = "S"),
			    'fact_sales_order_freight'[transaction_quantity]
			        * COALESCE(
			            RELATED(dim_uom_conversion_item[conv_factor]),
			            RELATED(dim_uom_conversion[std_factor]),
			            0
			        )
			)
		lineageTag: 7871063b-dac0-4cff-98de-1beea278ec3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Shipped volume in short tons, limited to product (stock) lines only
	measure 'Product Shipped Tons' =
			SUMX(
			    FILTER('fact_sales_order_freight', TRIM('fact_sales_order_freight'[line_type]) = "S"),
			    'fact_sales_order_freight'[quantity_shipped]
			        * COALESCE(
			            RELATED(dim_uom_conversion_item[conv_factor]),
			            RELATED(dim_uom_conversion[std_factor]),
			            0
			        )
			)
		lineageTag: 7af5f46d-e9e9-4965-9e62-812c663ef372

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Same as Total Tons but excludes F/FT freight lines (SOP620 blank on freight).
	measure 'Total Tons (Product)' =
			
			SUMX(
			    FILTER('fact_sales_order_freight',
			        NOT(TRIM('fact_sales_order_freight'[line_type]) = "F"
			         || TRIM('fact_sales_order_freight'[line_type]) = "FT")),
			    'fact_sales_order_freight'[transaction_quantity]
			      * COALESCE(
			          IF(TRIM('fact_sales_order_freight'[uom]) = "TN", 1.0),
			          RELATED(dim_uom_conversion_item[conv_factor]),
			          RELATED(dim_uom_conversion[std_factor]),
			          0))
		lineageTag: 18c2f7c8-d380-4121-b3f3-25e99839a8eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Freight-excluded price per ton (SOP620; blank on freight rows).
	measure 'Price Per Ton (Product)' = DIVIDE([Product Price], [Total Tons (Product)])
		lineageTag: e5e6a1e4-6042-4749-888d-c841f5078ded

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Report-scoped duplicate of Product Price (non-freight lines only).
	measure 'Product Price (Product)' =
			
			SUMX(
			    FILTER('fact_sales_order_freight',
			        NOT(TRIM('fact_sales_order_freight'[line_type]) = "F"
			         || TRIM('fact_sales_order_freight'[line_type]) = "FT")),
			    'fact_sales_order_freight'[extended_price])
		lineageTag: c1e25823-ed49-4aa8-ab99-91d8e104d699

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the most recent timestamp from a table in Eastern Time (ET). It ignores any visual, page, or report-level filters.
	measure 'JDE Last Updated' =
			
			VAR _ts = CALCULATE (
			        	MAX ( 'fact_sales_order_freight'[jde_updated_ts] ),
			        	REMOVEFILTERS ()
			    	)
			RETURN
			    IF ( NOT ISBLANK ( _ts ), FORMAT ( _ts, "MM/dd/yyyy HH:mm:ss" ) )
		lineageTag: d70199ac-560d-4bee-afe3-722aa6e35b70

	/// Shipment total_freight x shift factor, deduped per shipment.
	measure 'BP Freight Amount' =
			
			SUMX(VALUES('fact_sales_order_freight'[shipment_number]),
			     CALCULATE(MAX('fact_sales_order_freight'[total_freight])
			             * MAX('fact_sales_order_freight'[shift_factor_applied])))
		lineageTag: da778354-f45c-440e-9348-9f6b2456e74b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Shipped qty re-expressed in pricing UOM; BLANK when line UOM = pricing UOM.
	measure 'Price QTY Shipped' =
			
			SUMX('fact_sales_order_freight',
			  IF(TRIM([uom]) = TRIM([unit_price_primary]),
			     BLANK(),
			     [quantity_shipped] * DIVIDE(RELATED(dim_uom_conversion_item[conv_factor]),
			       LOOKUPVALUE(dim_uom_conversion_item[conv_factor],
			                   dim_uom_conversion_item[item_uom_key],
			                   [item_number_short] & "|" & TRIM([unit_price_primary])))))
		lineageTag: c41c4de3-0f56-45b4-b99c-e676f4f99a73

		annotation PBI_FormatHint = {"isGeneralNumber":true}

