	/// Which report(s) a row belongs to. Five mutually-exclusive classes, all CALCULATED (the notebook
	/// filters nothing — the fact is F4211 and F4311 in full):
	///   LINE      F4211 line, not TL, not HOLADD  -> Sandbox Load Report w/ PO Details (+ (New), + no-USS) and Reconciliation
	///   HOLADD    F4211 line, not TL, item HOLADD -> ...for HOLADD  and Reconciliation
	///   TEXT      F4211 line, line type TL        ->                   Reconciliation
	///   PO_HOLADD F4311 line, OX + item HOLADD    -> ...for HOLADD  (with po_holadd_superseded = "N")
	///   PO_OTHER  every other F4311 line          -> NO report reads it
	/// EVERY report page MUST filter on this column — see docs/ESO5_gold_layer_design.md §7b.
	/// NOTE [document_type] is forced to "SX" on PO rows, so it alone does NOT exclude them; row_class does.
	column row_class
		dataType: string
		summarizeBy: none
		sourceColumn: row_class
		lineageTag: 1a4e9c37-05b8-4d62-9e71-8c30f5ab6d24

