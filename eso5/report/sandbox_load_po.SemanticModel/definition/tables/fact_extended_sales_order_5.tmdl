	/// Numeric copy of [next_status] for the core report's page filter SDNXTR < '581'. Hubble does this as
	/// a STRING comparison, which only orders correctly while every status is a uniform 3-char code; this
	/// integer column makes the filter next_status_num < 581 unambiguous. NULL where next_status is blank
	/// or non-numeric. Display uses [next_status]; filter on this.
	column next_status_num
		dataType: int64
		summarizeBy: none
		sourceColumn: next_status_num
		lineageTag: e1f2a3b4-c5d6-47e8-9a0b-1c2d3e4f5a6b

