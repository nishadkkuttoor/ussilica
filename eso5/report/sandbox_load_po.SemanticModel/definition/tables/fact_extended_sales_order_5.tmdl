	/// STATUS. The notebook applies NO status filter anywhere — every status predicate that used to drop
	/// rows is now one of these fields, and status filtering is entirely the report's job (design §7d).
	///
	/// 'Y' ⇔ the load already carries a LIVE (last_status <> "980") SX HOLADD sales line. This WAS report
	/// 4's `NOT EXISTS(...)`, which suppressed the PO row. Hubble's orphan set is exactly "N", so report 4
	/// filters po_holadd_superseded = "N". Always "N" on non-PO_HOLADD rows.
	column po_holadd_superseded
		dataType: string
		summarizeBy: none
		sourceColumn: po_holadd_superseded
		lineageTag: 8c41d70e-5b93-4a26-b1f8-e03927ad6c15

	/// PDDCTO on a purchase-order row. [document_type] is forced to "SX" on those rows (the query hard-codes
	/// it so the UNION lines up with the sales load), so the PO's own document type needs its own column.
	/// NULL on F4211 rows.
	column po_order_type
		dataType: string
		summarizeBy: none
		sourceColumn: po_order_type
		lineageTag: 3d92c0f5-7a41-4e68-b530-9c74e1a8d206

	/// MXLTTR / MILTTR — the reconciliation view's per-load MAX/MIN of last_status, and the two inputs to
	/// [load_last_status]. Surfaced so the report can audit or re-derive that CASE rather than trusting a
	/// status rule baked into the fact.
	column load_max_last_status
		dataType: string
		summarizeBy: none
		sourceColumn: load_max_last_status
		lineageTag: 4e93a02c-16bf-4d78-95a1-c780b62e3fd4

	column load_min_last_status
		dataType: string
		summarizeBy: none
		sourceColumn: load_min_last_status
		lineageTag: a57f28d1-c604-49eb-83b7-9e21d0576cb8

	/// The F4311 OX money with NO item/status condition. [ox_amount] follows Hubble's rule
	/// (item="FRT", or item="HOLADD" AND last_status<>"980", else 0) — which bakes a status decision into
	/// the value. This column exposes the same money unconditioned, so the report can apply its own.
	column ox_amount_gross
		dataType: double
		summarizeBy: none
		sourceColumn: ox_amount_gross
