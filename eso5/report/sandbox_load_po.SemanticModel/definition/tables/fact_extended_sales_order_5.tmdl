table fact_extended_sales_order_5
	lineageTag: b984ce0d-eb27-4501-5c56-421ff2dad32e

	/// SEMI-ADDITIVE. lofa_rate is a per-Loading-Facility rate, physically repeated on every line of every
	/// load that ships from that facility — a plain SUM would multiply it by the line count. SUMX over
	/// VALUES() counts each facility exactly once, whatever the grain of the visual.
	measure 'Rate' = SUMX(VALUES(fact_extended_sales_order_5[loading_facility]), CALCULATE(MAX(fact_extended_sales_order_5[lofa_rate])))
		formatString: \$#,0.00;-\$#,0.00
		displayFolder: Amounts
		lineageTag: 69b96f30-cb8f-a6e8-67bd-67c9af742ee7

	measure 'Total Amount' = SUM(fact_extended_sales_order_5[total_amount])
		formatString: \$#,0;-\$#,0
		displayFolder: Amounts
		lineageTag: 1068a8f9-27b6-e55a-c23c-4a219cd9a5e4

	measure 'OX Amount' = SUM(fact_extended_sales_order_5[ox_amount])
		formatString: \$#,0;-\$#,0
		displayFolder: Amounts
		lineageTag: 4b894999-c896-ee40-795f-ea0db3bef328

	measure 'Quantity' = SUM(fact_extended_sales_order_5[quantity])
		formatString: #,0.00
		displayFolder: Weights & Qty
		lineageTag: ad5962df-df3a-304e-06c3-a5c4ff8f1ff4

	/// PER-LOAD, not per-line. SOWEIGHT is one value for the whole load, physically repeated on every line
	/// of it — a plain SUM multiplies it by the line count. SUMX over VALUES(load_scope_key) counts each
	/// load exactly once. load_scope_key is used rather than load_number because it is sha2(company ‖
	/// document_type ‖ load_number) — the true load identity, so this stays correct even on a visual that
	/// spans companies or document types.
	measure 'USS SO Weight' = SUMX(VALUES(fact_extended_sales_order_5[load_scope_key]), CALCULATE(MAX(fact_extended_sales_order_5[uss_so_weight])))
		formatString: #,0.00
		displayFolder: Weights & Qty
		lineageTag: 470a8641-4707-ae4a-0895-f84ec0ddea6f

	/// PER-LOAD, not per-line — SXWEIGHT is one value for the whole load. Same dedup as USS SO Weight.
	measure 'SBX Weight' = SUMX(VALUES(fact_extended_sales_order_5[load_scope_key]), CALCULATE(MAX(fact_extended_sales_order_5[sbx_weight])))
		formatString: #,0.00
		displayFolder: Weights & Qty
		lineageTag: 0707632e-3773-4b6a-1fd8-5f398b7c179d

	/// Counts LOADS, on load_scope_key = sha2(company ‖ document_type ‖ load_number) — the true load
	/// identity. DISTINCTCOUNT(load_number) alone would conflate two loads that share a document number
	/// under different companies or document types, which the fact now spans.
	measure 'Load Count' = DISTINCTCOUNT(fact_extended_sales_order_5[load_scope_key])
		formatString: #,0
		displayFolder: Counts
		lineageTag: 370a982f-018d-f9fc-3040-7883eb85f495

	measure 'Line Count' = COUNTROWS(fact_extended_sales_order_5)
		formatString: #,0
		displayFolder: Counts
		lineageTag: f4633173-b1aa-1941-3ccf-a6a506b61596

	/// SBX Load Reconciliation Report — the per-load pivots of its SBXLOADDETAIL view, expressed over
	/// the same line-grain rows. Every one restricts to row_class IN ("LINE","HOLADD","TEXT") — exactly
	/// SBXLOADDETAIL's population, which is F4201 INNER JOIN F4211 and never sees F4311.
	/// ⚠ FIXED 2026-07-20. These previously guarded `row_class <> "PO_HOLADD"`, which was wrong twice
	/// over: (a) it does NOT exclude PO_OTHER — every F4311 line that is not OX+HOLADD — and those rows
	/// carry item_number = PDLITM and units_ordered = PDUORG, so any measure keyed on item_number
	/// double-counted (Miles was the visible one: 54 became 108); and (b) a boolean predicate inside
	/// CALCULATE is FILTER(ALL(column), ...), so it REPLACED the page filter on row_class rather than
	/// intersecting with it — meaning a correctly-filtered page could not save it. The positive set is
	/// self-sufficient: these are right even with no page filter at all.
	measure 'Sand Weight' = CALCULATE(SUM(fact_extended_sales_order_5[units_ordered]), fact_extended_sales_order_5[product_category] = "COM", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: #,0.00
		displayFolder: Reconciliation\Weights
		lineageTag: 2f0a1c74-6b9e-4d51-9c02-1a5e77b30d41

	measure 'Ext Weight' = CALCULATE(SUM(fact_extended_sales_order_5[item_weight]), fact_extended_sales_order_5[product_category] = "FRT", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: #,0.00
		displayFolder: Reconciliation\Weights
		lineageTag: 7c31b6a2-04df-4e18-8a77-c5b9021ee3d6

	measure 'Sand Tons' = DIVIDE([Sand Weight], 2000)
		formatString: #,0.00
		displayFolder: Reconciliation\Weights
		lineageTag: b8d4e017-95a3-4c60-b21f-3e7ac9d4f582

	measure 'Ext Tons' = DIVIDE([Ext Weight], 2000)
		formatString: #,0.00
		displayFolder: Reconciliation\Weights
		lineageTag: 0e6f27bb-c1a8-4972-93d5-6bd0c81a4e77

	measure 'Miles' = CALCULATE(SUM(fact_extended_sales_order_5[units_ordered]), fact_extended_sales_order_5[item_number] = "FRT", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: #,0.00
		displayFolder: Reconciliation\Detention & Miles
		lineageTag: 5a9c3d8e-72b1-4f06-ae34-9d02c7b155a9

	measure 'LOFA Detention Hours' = CALCULATE(SUM(fact_extended_sales_order_5[units_ordered]), fact_extended_sales_order_5[item_number] = "LOFADET", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: #,0.00
		displayFolder: Reconciliation\Detention & Miles
		lineageTag: 91b7f0c5-3e26-48da-bc19-4f8e6a0d2731

	measure 'Well Detention Hours' = CALCULATE(SUM(fact_extended_sales_order_5[units_ordered]), fact_extended_sales_order_5[item_number] = "WELLDET", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: #,0.00
		displayFolder: Reconciliation\Detention & Miles
		lineageTag: 6d20a94f-88c7-41b3-95e0-7ab3c1f6e408

	measure 'LOFA Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[item_number] = "LOFADET", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: c4e81b36-1d59-4a7c-8f62-20be95d7a013

	measure 'Well Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[item_number] = "WELLDET", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: a70d5c92-6f34-4e88-b1a7-8c53d0e26bf1

	measure 'LOFA PP Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[item_number] = "LOFADETPP", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: 3fb69e04-52ca-4d17-9036-e8a71b45cd29

	measure 'Well PP Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[item_number] = "WELLDETPP", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: 8e1c47a5-b930-4265-a7d8-15f2609be3c4

	measure 'LOFA PB Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[item_number] = "LOFADETPB", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: d52a8f13-7e46-49b0-83c1-6079ba4e18d7

	measure 'Well PB Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[item_number] = "WELLDETPB", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: 14b0e6da-9c25-4f73-b58a-2d1e7c930fb6

	measure 'Freight Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[product_category] = "FRT", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: 9a3d71ec-40b8-4a19-96f5-c7e208b4d165

	measure 'Fuel Surcharge Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[item_number] = "FSC", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: 47f9c0b8-2a61-4d3e-8b74-591ae6c2073b

	/// SANDAMT keys off the sales reporting code (SDSRP1 = '352'), NOT the item number.
	measure 'Sand Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[sales_report_code_01] = "352", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: e206b5d4-8f17-4c92-a0e3-73b6d19af845

	measure 'Holding Amount' = CALCULATE(SUM(fact_extended_sales_order_5[total_amount]), fact_extended_sales_order_5[item_number] = "HOLADD", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: \$#,0;-\$#,0
		displayFolder: Reconciliation\Amounts
		lineageTag: 5b8e39f7-c04a-4d16-92b8-a1c76e0d4239

	/// PROP / LOFA on the reconciliation view are the COM (sand) line's values, not the current row's.
	measure 'Proppant' = CALCULATE(MAX(fact_extended_sales_order_5[item_description]), fact_extended_sales_order_5[product_category] = "COM", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		displayFolder: Reconciliation
		lineageTag: 76c1a80b-e534-4f28-b96d-0e83f27ac541

	measure 'Load LOFA' = CALCULATE(MAX(fact_extended_sales_order_5[loading_facility]), fact_extended_sales_order_5[product_category] = "COM", fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: 0
		displayFolder: Reconciliation
		lineageTag: 28d7f4a6-91b0-4e35-87c2-4fd6903be172

	/// SBXLOADDETAIL_GLDATE — the load's G/L date, MAX(SDDGL) across its lines. A measure and not a
	/// column: the model discourages implicit measures, and gl_date can differ line to line, so using
	/// it as a grouping column would split one load into several rows.
	measure 'Load GL Date' = CALCULATE(MAX(fact_extended_sales_order_5[gl_date]), fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: mm/dd/yyyy
		displayFolder: Reconciliation
		lineageTag: a1c47f30-8b62-4d19-9e05-3f7c81d2b640

	/// SBXLOADDETAIL_SDDOC — the load's invoice number, MAX(SDDOC) across its lines. Same reasoning as
	/// [Load GL Date].
	measure 'Load Invoice No' = CALCULATE(MAX(fact_extended_sales_order_5[invoice_number]), fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		formatString: 0
		displayFolder: Reconciliation
		lineageTag: b2d58e41-9c73-4e2a-8f16-4a8d92e3c751

	/// SBXLOADDETAIL_SDNXTR — the load's next status, MAX(SDNXTR) across its lines. Same reasoning as
	/// [Load GL Date]. Note this is the LINE-level next status rolled up; [load_last_status] is a
	/// different thing — a derived CASE reproduced in the notebook (design §3e).
	measure 'Load Next Status' = CALCULATE(MAX(fact_extended_sales_order_5[next_status]), fact_extended_sales_order_5[row_class] IN { "LINE", "HOLADD", "TEXT" })
		displayFolder: Reconciliation
		lineageTag: c3e69f52-ad84-4f3b-9027-5b9ea3f4d862

